{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "melsou",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./demo",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    { "binding": "MELSOU_ASSETS", "bucket_name": "melsou-hot-private", "preview_bucket_name": "melsou-hot-private-preview" }
  ],
  "images": { "binding": "IMAGES" },
  "vars": {
    "APP_ENV": "production",
    "SEPAY_ALLOWED_CLOCK_SKEW_SECONDS": "300"
  },
  "triggers": { "crons": ["17,47 * * * *"] }
}
