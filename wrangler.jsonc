{
  "$schema": "https://json.schemastore.org/wrangler",
  "name": "melsou",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-08-26",
  "assets": {
    "directory": "./demo/recovery_fb38",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SEPAY_ALLOWED_CLOCK_SKEW_SECONDS": "300",
    "VOICE_MAX_BYTES": "5242880",
    "SUPABASE_STORAGE_BUCKET": "melsou-assets"
  },
  "triggers": { "crons": ["17,47 * * * *"] }
}
