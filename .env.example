# Public application settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server credentials
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=melsou-assets
OWNER_EMAIL=
OWNER_USER_ID=

# Native username auth and optional verified-email delivery
APP_BASE_URL=http://localhost:3000
AUTH_EMAIL_DELIVERY_URL=
AUTH_EMAIL_DELIVERY_TOKEN=

# Private Supabase Storage (accessed server-side only through the service role)
VOICE_MAX_BYTES=5242880
# Must match the approved ISD1820/fulfilment workflow; never guess this value.
VOICE_MAX_DURATION_SECONDS=
VOICE_PROCESSOR_URL=
VOICE_PROCESSOR_TOKEN=

# Google OAuth configured in Supabase
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# SePay: verify webhook signatures server-side before state changes
SEPAY_MODE=TEST
SEPAY_API_KEY=
SEPAY_WEBHOOK_SECRET=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NAME=

# Google archive/reporting service account (server-side only)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ARCHIVE_FOLDER_ID=
GOOGLE_SHEETS_REPORTING_ID=

# Print values are deliberately unset until received from the print vendor
TBD_PRINT_VENDOR_FINISHED_WIDTH_MM=
TBD_PRINT_VENDOR_FINISHED_HEIGHT_MM=
TBD_PRINT_VENDOR_COVER_WIDTH_MM=
TBD_PRINT_VENDOR_COVER_HEIGHT_MM=
TBD_PRINT_VENDOR_BLEED_MM=
TBD_PRINT_VENDOR_SAFE_MARGIN_MM=
TBD_PRINT_VENDOR_GUTTER_WARNING_MM=
TBD_PRINT_VENDOR_DPI=
TBD_PRINT_VENDOR_COLOR_PROFILE=
TBD_PRINT_VENDOR_PDF_STANDARD=
TBD_PRINT_VENDOR_COVER_CONSTRUCTION=
